{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "samples"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "samples": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "source", "editorNotation", "expectedKundoku", "rules"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "editorNotation": { "type": "string" },
          "schoolNotation": { "type": "string", "minLength": 1 },
          "kundoku": { "type": "string", "minLength": 1 },
          "expectedKundoku": { "type": "string", "minLength": 1 },
          "rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["re-point", "numeric-return", "upper-lower-return", "upper-middle-lower-return", "okurigana", "punctuation", "okiji"] } }
        }
      }
    }
  }
}
